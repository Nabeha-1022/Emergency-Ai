# Backend Environment Variables
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MongoDB (optional - system falls back to TinyDB JSON if unavailable)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=emergency_ai

# Set to "true" to force JSON fallback even if MongoDB is available
USE_JSON_FALLBACK=false

# Whisper STT model size: tiny, base, small, medium, large
# Set to "demo" to use fallback text
WHISPER_MODEL=demo

# Operator credentials (demo)
DEMO_OPERATOR_EMAIL=operator@emergency.ai
DEMO_OPERATOR_PASSWORD=operator123
DEMO_OPERATOR_NAME=John Smith
